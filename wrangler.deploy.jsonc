{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinflix",
  "main": ".cloudflare/output/v0/workers/default/bundle/index.js",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "pinflix.pincodeit.com",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "ASSETS",
      "service": "pinflix-assets"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}

# Server-only TMDB application credential.
# Get the API Read Access Token from your TMDB account API settings.
TMDB_READ_ACCESS_TOKEN=

# Optional authorized MovieBox API configuration.
# The provider client only sends credentials you explicitly configure.
# Protected playback cookies/signatures are not decoded or proxied.
MOVIEBOX_API_BASE=
MOVIEBOX_AUTH_HEADER=
MOVIEBOX_AUTH_VALUE=

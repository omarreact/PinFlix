generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String?
  role          String        @default("USER")
  status        String        @default("ACTIVE")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  profiles      Profile[]
  subscriptions Subscription[]
}

model Profile {
  id        String          @id @default(cuid())
  userId    String
  name      String
  avatar    String?
  isKids    Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  myList    MyList[]
  progress  WatchProgress[]
  events    WatchEvent[]

  @@index([userId])
}

model Title {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  originalName   String?
  type           String        @default("MOVIE")
  status         String        @default("DRAFT")
  overview       String
  releaseYear    Int?
  runtimeMinutes Int?
  maturityRating String?
  featured       Boolean       @default(false)
  trendingScore  Float         @default(0)
  rating         Float?
  ratingCount    Int           @default(0)
  posterPath     String
  backdropPath   String
  logoPath       String?
  trailerUrl     String?
  country        String?
  language       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?
  genres         TitleGenre[]
  seasons        Season[]
  streams        StreamSource[]
  subtitles      SubtitleTrack[]
  myList         MyList[]
  progress       WatchProgress[]
  events         WatchEvent[]

  @@index([slug])
  @@index([status])
  @@index([type])
  @@index([releaseYear])
  @@index([trendingScore])
}

model Genre {
  id     String       @id @default(cuid())
  name   String       @unique
  slug   String       @unique
  titles TitleGenre[]
}

model TitleGenre {
  titleId String
  genreId String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([titleId, genreId])
}

model Season {
  id         String    @id @default(cuid())
  titleId    String
  number     Int
  name       String?
  overview   String?
  posterPath String?
  createdAt  DateTime  @default(now())
  title      Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes   Episode[]

  @@unique([titleId, number])
  @@index([titleId])
}

model Episode {
  id             String        @id @default(cuid())
  seasonId       String
  number         Int
  name           String
  overview       String?
  runtimeMinutes Int?
  stillPath      String?
  airDate        DateTime?
  createdAt      DateTime      @default(now())
  season         Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  streams        StreamSource[]
  subtitles      SubtitleTrack[]
  progress       WatchProgress[]
  events         WatchEvent[]

  @@unique([seasonId, number])
  @@index([seasonId])
}

model StreamSource {
  id                   String         @id @default(cuid())
  titleId              String?
  episodeId            String?
  label                String
  protocol             String         @default("HLS")
  url                  String
  qualityLabel         String
  width                Int?
  height               Int?
  bitrate              Int?
  isDefault            Boolean        @default(false)
  priority             Int            @default(0)
  isActive             Boolean        @default(true)
  requiresSubscription Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  title                Title?         @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episode              Episode?       @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([titleId])
  @@index([episodeId])
}

model SubtitleTrack {
  id        String   @id @default(cuid())
  titleId   String?
  episodeId String?
  language  String
  label     String
  url       String
  format    String   @default("VTT")
  isDefault Boolean  @default(false)
  title     Title?   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([titleId])
  @@index([episodeId])
}

model MyList {
  id        String   @id @default(cuid())
  profileId String
  titleId   String
  titleName String?
  posterUrl String?
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     Title?   @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([profileId, titleId])
  @@index([profileId])
}

model WatchProgress {
  id              String   @id @default(cuid())
  profileId       String
  titleId         String?
  episodeId       String?
  positionSeconds Int      @default(0)
  durationSeconds Int      @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title           Title?   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([profileId, titleId, episodeId])
  @@index([profileId])
}

model WatchEvent {
  id              String   @id @default(cuid())
  profileId       String
  titleId         String?
  episodeId       String?
  event           String
  positionSeconds Int      @default(0)
  createdAt       DateTime @default(now())
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title           Title?   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model Plan {
  id                String        @id @default(cuid())
  slug              String        @unique
  name              String
  priceMonthlyCents Int
  currency          String        @default("USD")
  maxProfiles       Int           @default(2)
  maxStreams        Int           @default(1)
  maxQuality        String        @default("720p")
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  subscriptions     Subscription[]
}

model Subscription {
  id                     String                 @id @default(cuid())
  userId                 String
  planId                 String
  provider               String                 @default("DEMO")
  providerCustomerId     String?
  providerSubscriptionId String?
  status                 String                 @default("ACTIVE")
  periodStart            DateTime?
  periodEnd              DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan                   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
}
